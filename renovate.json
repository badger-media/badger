{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "dependencyDashboard": true,
  "schedule": [
    "before 5am on Monday"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 10,
  "packageRules": [
    {
      "description": "Replace deprecated @tsconfig/node18 with the newer @tsconfig/node20",
      "matchPackageNames": ["@tsconfig/node18"],
      "groupName": "tsconfig updates",
      "allowedVersions": "<=20",
      "replaceString": "@tsconfig/node20"
    },
    {
      "description": "Ignore unmaintained type definitions that have no replacement",
      "matchPackageNames": ["@types/detect-port", "@types/react-datepicker"],
      "enabled": false
    },
    {
      "description": "Auto‑merge minor/patch updates for non‑critical deps",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "branch"
    }
  ],
  "ignoreDeps": [
    "@types/detect-port",
    "@types/react-datepicker"
  ],
  "semanticCommits": "enabled",
  "commitMessagePrefix": "chore(deps):"
}
